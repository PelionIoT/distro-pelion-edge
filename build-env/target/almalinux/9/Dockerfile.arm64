# AlmaLinux 9 (aarch64) build environment for Pelion Edge RPMs.
#
# Built through QEMU binfmt; see the README note about docker/binfmt.
#
# Unlike the RHEL 8 target, this image needs no Red Hat subscription and no
# RH_USERNAME/RH_PASSWORD build args. The RHEL image has to register with
# subscription-manager purely to unlock codeready-builder (CRB), which carries
# the -devel packages the specs need. AlmaLinux ships the same content as the
# free "crb" repository, and EPEL 9 is public.
#
# Override the minor release with --build-arg ALMA_TAG=9.8 if you need to pin.
ARG ALMA_TAG=9
FROM almalinux:${ALMA_TAG}

ARG USER_ID
ARG GROUP_ID
# Passed unconditionally by docker_build_image; declared to silence the warning.
ARG PREFIX

# crb is the CodeReady Builder equivalent and is disabled by default.
RUN dnf install -y dnf-plugins-core epel-release && \
	dnf config-manager --set-enabled crb && \
	dnf clean all

# createrepo_c provides the /usr/bin/createrepo symlink the build scripts call.
RUN dnf install -y \
		createrepo_c \
		yum-utils \
		sudo \
		git \
		rpm-build \
		rpmdevtools \
		systemd-rpm-macros \
		golang && \
	dnf group install -y 'Development Tools' && \
	dnf clean all

RUN userdel -f user || true
RUN groupadd -f -o --gid $GROUP_ID user
RUN useradd -p '' --uid $USER_ID --gid $GROUP_ID user
RUN usermod -aG wheel user

COPY common/pelionbuilddeps.repo /etc/yum.repos.d/pelionbuilddeps.repo
RUN chmod 644 /etc/yum.repos.d/pelionbuilddeps.repo && \
	mkdir -p /opt/repo && \
	createrepo /opt/repo && \
	dnf clean all && \
	dnf update -y && \
	dnf clean expire-cache

COPY common/ssh_known_hosts /etc/ssh/ssh_known_hosts
RUN chmod 644 /etc/ssh/ssh_known_hosts

USER user
WORKDIR /pelion-build
