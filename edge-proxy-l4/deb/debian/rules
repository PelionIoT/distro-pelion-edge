#!/usr/bin/make -f

DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@ --with systemd

override_dh_auto_build:
	./debian/auto_build

override_dh_auto_clean:
	-rm -rf go-workspace

# The unit stays named edge-proxy.service even though the package is
# edge-proxy-l4, because edge-resource-manager, pe-terminal, kubelet, k3s and
# fluent-bit all declare Requires=edge-proxy.service. debhelper only picks up
# debian/<package>.<name>.service when a matching --name is passed, so every
# helper that touches the unit needs --name=edge-proxy.
override_dh_installinit:
	dh_installinit -pedge-proxy-l4 --name=edge-proxy --noscripts
	dh_installinit --remaining

override_dh_systemd_enable:
	dh_systemd_enable --name=edge-proxy

override_dh_systemd_start:
	dh_systemd_start --name=edge-proxy
